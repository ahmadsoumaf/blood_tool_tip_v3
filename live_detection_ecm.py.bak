"""
Live blood / instrument-tip detection on the dVRK ECM (endoscope) camera.

PERCEPTION ONLY: this script only *subscribes* to the ECM image topic over ROS 2.
It never publishes anything and never sends commands to the robot - nothing moves.

Same model and display as live_detection.py, but the ECM has no depth stream,
so "TIP IN BLOOD" is decided from the image only (tip mask overlaps blood mask)
and distances are shown in pixels.

Before running, start the camera in another terminal:
  source /opt/ros/jazzy/setup.bash
  source ~/Desktop/ros2_dvrk_ws/install/local_setup.bash
  ros2 launch dvrk_video decklink_stereo_goovis.launch.py stereo_rig_name:=leeds_dVRK

Every run is logged to logs/ecm_run_<date>_<time>.csv (+ videos), unless --no-log.

Keys:
  q - quit
  + / - - make the live window bigger / smaller
  0 - reset the live window size
  f - save the current raw camera image to new_training_images/
"""

import argparse
import csv
import os
import subprocess
import time
from collections import deque

import cv2
import numpy as np
import torch
from ultralytics import YOLO

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy
from sensor_msgs.msg import Image

ap = argparse.ArgumentParser()
ap.add_argument("--topic", default="/leeds_dVRK/left/image_rect",
                help="ROS 2 image topic (default: left rectified ECM image; e.g. /leeds_dVRK/right/image_raw)")
ap.add_argument("--conf", type=float, default=0.25, help="detection confidence threshold")
ap.add_argument("--imgsz", type=int, default=640, help="model input size")
ap.add_argument("--no-log", action="store_true", help="do not save a CSV log / videos for this run")
ap.add_argument("--snapshots", default=None, help="save an annotated frame every second to this folder")
ap.add_argument("--seconds", type=float, default=0, help="stop automatically after N seconds (0 = run until q)")
ap.add_argument("--aruco-dict", default="DICT_4X4_50", help="ArUco dictionary (or 'auto')")
ap.add_argument("--scale", type=float, default=0.75, help="start size of the live window (1280x720 * scale)")
ap.add_argument("--no-aruco", action="store_true", help="disable ArUco marker detection")
args = ap.parse_args()

DEVICE = 0 if torch.cuda.is_available() else "cpu"
PRECISION = 16 if DEVICE != "cpu" else None  # FP16 on GPU
print("Inference device:", torch.cuda.get_device_name(0) if DEVICE != "cpu" else "CPU")

model = YOLO(os.path.join(os.path.dirname(os.path.abspath(__file__)), "weights", "best.pt"))
print("Model loaded:", model.names)

BLOOD, INSTRUMENT = 0, 1
TIP = -1
TIP_RADIUS_PX = 12     # ECM image is 1280x720, a bit bigger than the RealSense one


# ---------------- ROS 2 image subscriber (read-only) ----------------
class EcmImage(Node):
    def __init__(self, topic):
        super().__init__("blood_tip_perception")
        qos = QoSProfile(reliability=ReliabilityPolicy.BEST_EFFORT, history=HistoryPolicy.KEEP_LAST, depth=1)
        self.sub = self.create_subscription(Image, topic, self.cb, qos)
        self.frame = None
        self.seq = 0

    def cb(self, msg):
        buf = np.frombuffer(msg.data, np.uint8)
        enc = msg.encoding.lower()
        ch = {"rgb8": 3, "bgr8": 3, "rgba8": 4, "bgra8": 4, "mono8": 1}.get(enc)
        if ch is None:
            self.get_logger().warn(f"unsupported encoding {msg.encoding}", throttle_duration_sec=5)
            return
        img = buf.reshape(msg.height, msg.step)[:, :msg.width * ch].reshape(msg.height, msg.width, ch)
        conv = {"rgb8": cv2.COLOR_RGB2BGR, "rgba8": cv2.COLOR_RGBA2BGR,
                "bgra8": cv2.COLOR_BGRA2BGR, "mono8": cv2.COLOR_GRAY2BGR}.get(enc)
        self.frame = cv2.cvtColor(img, conv) if conv is not None else img.copy()
        self.seq += 1


rclpy.init()
node = EcmImage(args.topic)
print("Waiting for images on", args.topic, "...")
t_wait = time.time()
while node.frame is None:
    rclpy.spin_once(node, timeout_sec=0.1)
    if time.time() - t_wait > 10:
        print("Still no image. Is the camera launch running, and is ROS sourced in this terminal?")
        t_wait = time.time()
HEIGHT, WIDTH = node.frame.shape[:2]
print(f"ECM camera connected: {WIDTH}x{HEIGHT}")
for _ in range(3):  # warm up the GPU so the first FPS/inference readings aren't misleading
    model.predict(node.frame, imgsz=args.imgsz, conf=args.conf, device=DEVICE, quantize=PRECISION,
                  retina_masks=True, verbose=False)

# ---------------- ArUco ----------------
aruco = cv2.aruco
ARUCO_DICTS = [n for n in [
    "DICT_4X4_50", "DICT_4X4_100", "DICT_4X4_250", "DICT_4X4_1000",
    "DICT_5X5_50", "DICT_5X5_100", "DICT_5X5_250", "DICT_5X5_1000",
    "DICT_6X6_50", "DICT_6X6_100", "DICT_6X6_250", "DICT_6X6_1000",
    "DICT_7X7_50", "DICT_7X7_100", "DICT_7X7_250", "DICT_7X7_1000",
    "DICT_ARUCO_ORIGINAL",
    "DICT_APRILTAG_16h5", "DICT_APRILTAG_25h9", "DICT_APRILTAG_36h10", "DICT_APRILTAG_36h11",
] if hasattr(aruco, n)]
ARUCO_SCAN_EVERY = 15
_aruco_params = aruco.DetectorParameters_create() if hasattr(aruco, "DetectorParameters_create") else aruco.DetectorParameters()
_aruco_params.cornerRefinementMethod = aruco.CORNER_REFINE_SUBPIX
_aruco_detectors = {}


def aruco_detect(gray, name):
    if hasattr(aruco, "ArucoDetector"):
        if name not in _aruco_detectors:
            _aruco_detectors[name] = aruco.ArucoDetector(aruco.getPredefinedDictionary(getattr(aruco, name)), _aruco_params)
        corners, ids, _ = _aruco_detectors[name].detectMarkers(gray)
    else:
        corners, ids, _ = aruco.detectMarkers(gray, aruco.Dictionary_get(getattr(aruco, name)), parameters=_aruco_params)
    return corners, ids


def aruco_find_dict(gray):
    best, best_n = None, 0
    for name in ARUCO_DICTS:
        _, ids = aruco_detect(gray, name)
        n = 0 if ids is None else len(ids)
        if n > best_n:
            best, best_n = name, n
    return best, best_n


aruco_dict = None if args.aruco_dict == "auto" else args.aruco_dict
if aruco_dict and aruco_dict not in ARUCO_DICTS:
    raise SystemExit(f"Unknown ArUco dictionary {aruco_dict}. Options: {', '.join(ARUCO_DICTS)}")
aruco_on = not args.no_aruco

COLORS = {BLOOD: (0, 0, 255), TIP: (255, 255, 0), INSTRUMENT: (0, 255, 0)}
ALPHA = 0.45
SMOOTH = 0.9
DIST_WINDOW = 9
DEADBAND_PX = 3.0
HOLD_FRAMES = 6
TOUCH_PX = 4
CONFIRM_FRAMES = 5
TRAIN_DIR = "new_training_images"
touch_kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (2 * TOUCH_PX + 1,) * 2)


def derive_tip_mask(inst_mask):
    """Tip = end of the instrument's long axis that is farther from the image border."""
    ys, xs = np.nonzero(inst_mask)
    if len(xs) < 20:
        return None
    h, w = inst_mask.shape
    pts = np.stack([xs, ys], axis=1).astype(np.float32)
    mean = pts.mean(axis=0)
    _, _, vt = np.linalg.svd(pts - mean, full_matrices=False)
    proj = (pts - mean) @ vt[0]
    ends = [pts[np.argmin(proj)], pts[np.argmax(proj)]]
    end = max(ends, key=lambda p: min(p[0], p[1], w - 1 - p[0], h - 1 - p[1]))
    yy, xx = np.ogrid[:h, :w]
    tip = ((xx - end[0]) ** 2 + (yy - end[1]) ** 2 <= TIP_RADIUS_PX ** 2) & inst_mask
    return tip if tip.any() else None


def put(img, text, org, color, scale=0.8):
    cv2.putText(img, text, org, cv2.FONT_HERSHEY_SIMPLEX, scale, (0, 0, 0), 4)
    cv2.putText(img, text, org, cv2.FONT_HERSHEY_SIMPLEX, scale, color, 2)


dist_hist = deque(maxlen=DIST_WINDOW)
dist_s = None


def smooth(val):
    global dist_s
    dist_hist.append(val)
    m = float(np.median(dist_hist))
    if dist_s is None or abs(m - dist_s) >= DEADBAND_PX:
        dist_s = m
    return dist_s


def reset_smooth():
    global dist_s
    dist_hist.clear()
    dist_s = None


# ---------------- fovea (colour only, no depth on the ECM) ----------------
FOVEA, FOVEA_ZOOM, FOVEA_FOLLOW = 96, 4, 0.5
fovea_c = None


def crop_fixed(img, cx, cy, size=FOVEA):
    pad = size // 2
    padded = cv2.copyMakeBorder(img, pad, pad, pad, pad, cv2.BORDER_CONSTANT, value=0)
    x0, y0 = int(round(cx)), int(round(cy))
    return padded[y0:y0 + size, x0:x0 + size]


def make_fovea_view(frame, class_masks, center, tip_found):
    cx, cy = center
    z = FOVEA * FOVEA_ZOOM
    col = cv2.resize(crop_fixed(frame, cx, cy), (z, z), interpolation=cv2.INTER_NEAREST)
    for cls in (BLOOD, INSTRUMENT, TIP):
        m = class_masks.get(cls)
        if m is None:
            continue
        mc = cv2.resize(crop_fixed(m.astype(np.uint8), cx, cy), (z, z), interpolation=cv2.INTER_NEAREST)
        cnts, _ = cv2.findContours(mc, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
        cv2.drawContours(col, cnts, -1, COLORS[cls], 2)
    c = z // 2
    cv2.line(col, (c - 12, c), (c + 12, c), (255, 255, 255), 1)
    cv2.line(col, (c, c - 12), (c, c + 12), (255, 255, 255), 1)
    if not tip_found:
        put(col, "TIP LOST", (8, 28), (0, 165, 255), 0.7)
    return col


WIN_MAIN = "ECM - Blood / Tip perception"
WIN_FOVEA = "Fovea (tip zoom)"
WIN_FLAGS = cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO | cv2.WINDOW_GUI_NORMAL
SCALE_STEP, SCALE_MIN, SCALE_MAX = 1.25, 0.25, 3.0
win_scale = min(max(args.scale, SCALE_MIN), SCALE_MAX)
cv2.namedWindow(WIN_MAIN, WIN_FLAGS)
cv2.namedWindow(WIN_FOVEA, WIN_FLAGS)
cv2.resizeWindow(WIN_MAIN, int(WIDTH * win_scale), int(HEIGHT * win_scale))
cv2.resizeWindow(WIN_FOVEA, FOVEA * FOVEA_ZOOM, FOVEA * FOVEA_ZOOM)
cv2.moveWindow(WIN_MAIN, 0, 0)
cv2.moveWindow(WIN_FOVEA, int(WIDTH * win_scale) + 10, 0)

# ---------------- logging / video ----------------
FPS = 30  # nominal; videos are re-timed to the real run length at the end
t_start = time.time()
last_snap = 0.0
frame_idx = 0
log_f = log = None
video_writer = raw_writer = video_path = raw_path = None
if not args.no_log:
    os.makedirs("logs", exist_ok=True)
    log_path = os.path.join("logs", time.strftime("ecm_run_%Y%m%d_%H%M%S.csv"))
    log_f = open(log_path, "w", newline="")
    log = csv.writer(log_f)
    log.writerow(["time_s", "frame", "tip_detected", "blood_detected", "tip_u", "tip_v",
                  "in_blood", "raw_in_blood", "dist_px", "dist_px_smoothed", "status", "aruco_ids"])
    print("Logging to", log_path)
    video_path = log_path.replace(".csv", ".mp4")
    raw_path = log_path.replace(".csv", "_raw.mp4")
    video_writer = cv2.VideoWriter(video_path, cv2.VideoWriter_fourcc(*"mp4v"), FPS, (WIDTH, HEIGHT))
    raw_writer = cv2.VideoWriter(raw_path, cv2.VideoWriter_fourcc(*"mp4v"), FPS, (WIDTH, HEIGHT))
    if not (video_writer.isOpened() and raw_writer.isOpened()):
        print("WARNING: could not open video writer, no video will be saved")
        video_writer = raw_writer = None
if args.snapshots:
    os.makedirs(args.snapshots, exist_ok=True)


def finish_video(writer, path):
    writer.release()
    tmp = path.replace(".mp4", "_h264.mp4")
    scale = (run_end - t_start) / (frame_idx / FPS) if frame_idx else 1.0
    ok = subprocess.run(["ffmpeg", "-nostdin", "-v", "error", "-y", "-i", path,
                         "-vf", f"setpts={scale:.5f}*PTS", "-r", str(FPS), "-c:v", "libx264",
                         "-preset", "fast", "-crf", "20", "-pix_fmt", "yuv420p", tmp],
                        stdin=subprocess.DEVNULL).returncode == 0 if _has_ffmpeg() else False
    if ok:
        os.replace(tmp, path)
    print("Video saved:", path)


def _has_ffmpeg():
    from shutil import which
    return which("ffmpeg") is not None


loop_fps = infer_ms = None
last_time = time.perf_counter()
saved_msg_until = 0.0
lost_frames = 0
last_dist_text, last_dist_color = None, (255, 255, 255)
in_blood_state = False
pending_frames = 0
last_seq = 0

try:
    while rclpy.ok():
        # wait for a NEW frame (always use the latest one, drop older ones)
        rclpy.spin_once(node, timeout_sec=0.05)
        if node.seq == last_seq:
            if cv2.waitKey(1) & 0xFF == ord("q"):
                break
            continue
        last_seq = node.seq
        frame = node.frame
        h, w = frame.shape[:2]

        start = time.perf_counter()
        result = model.predict(frame, imgsz=args.imgsz, conf=args.conf, device=DEVICE, quantize=PRECISION,
                               retina_masks=True, verbose=False)[0]
        infer = (time.perf_counter() - start) * 1000.0
        infer_ms = infer if infer_ms is None else SMOOTH * infer_ms + (1 - SMOOTH) * infer

        annotated = frame.copy()
        class_masks = {}
        if result.masks is not None:
            masks = result.masks.data.cpu().numpy()
            classes = result.boxes.cls.cpu().numpy().astype(int)
            confs = result.boxes.conf.cpu().numpy()
            for cls in (INSTRUMENT, BLOOD):
                idx = np.where(classes == cls)[0]
                if len(idx) == 0:
                    continue
                if cls == INSTRUMENT:
                    idx = idx[[np.argmax(confs[idx])]]
                merged = masks[idx].max(axis=0)
                if merged.shape != (h, w):
                    merged = cv2.resize(merged, (w, h), interpolation=cv2.INTER_LINEAR)
                mask = merged > 0.5
                class_masks[cls] = mask
                annotated[mask] = ((1 - ALPHA) * annotated[mask] + ALPHA * np.array(COLORS[cls])).astype(np.uint8)

        if class_masks.get(INSTRUMENT) is not None:
            tm = derive_tip_mask(class_masks[INSTRUMENT])
            if tm is not None:
                class_masks[TIP] = tm
                annotated[tm] = ((1 - ALPHA) * annotated[tm] + ALPHA * np.array(COLORS[TIP])).astype(np.uint8)

        aruco_ids = []
        if aruco_on:
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
            if aruco_dict is None and frame_idx % ARUCO_SCAN_EVERY == 0:
                found, n = aruco_find_dict(gray)
                if found:
                    aruco_dict = found
                    print(f"ArUco dictionary detected: {aruco_dict} ({n} markers in view)")
            if aruco_dict is not None:
                a_corners, a_ids = aruco_detect(gray, aruco_dict)
                if a_ids is not None:
                    aruco.drawDetectedMarkers(annotated, a_corners, a_ids)
                    aruco_ids = sorted(int(i) for i in a_ids.flatten())

        # ---------------- tip -> blood (image only) ----------------
        dist_text, dist_color = None, (255, 255, 255)
        tip_mask, blood_mask = class_masks.get(TIP), class_masks.get(BLOOD)
        raw_in, tip_px, dist_px, status = False, None, None, ""
        if tip_mask is not None:
            ys, xs = np.nonzero(tip_mask)
            tip_px = (int(xs.mean()), int(ys.mean()))
        if tip_mask is not None and blood_mask is not None:
            if np.any((cv2.dilate(tip_mask.astype(np.uint8), touch_kernel) > 0) & blood_mask):
                raw_in, dist_px, status = True, 0.0, "overlap"
                dist_text, dist_color = "Tip touching blood (image)", (0, 165, 255)
            else:
                bys, bxs = np.nonzero(blood_mask)
                d = np.hypot(bxs - tip_px[0], bys - tip_px[1])
                k = int(np.argmin(d))
                dist_px, status = float(d[k]), "distance_px"
                cv2.line(annotated, tip_px, (int(bxs[k]), int(bys[k])), (0, 255, 255), 2)
                cv2.circle(annotated, (int(bxs[k]), int(bys[k])), 5, (0, 255, 255), -1)
                dist_text, dist_color = f"Tip -> blood: {smooth(dist_px):.0f} px", (0, 255, 255)
            lost_frames = 0
            last_dist_text, last_dist_color = dist_text, dist_color
        else:
            status = "no_tip" if tip_mask is None else "no_blood"
            lost_frames += 1
            if lost_frames <= HOLD_FRAMES and last_dist_text:
                dist_text, dist_color = last_dist_text, last_dist_color
            else:
                reset_smooth()
                dist_text = "No tip detected" if tip_mask is None else "No blood detected"

        if raw_in != in_blood_state:
            pending_frames += 1
            if pending_frames >= CONFIRM_FRAMES:
                in_blood_state, pending_frames = raw_in, 0
        else:
            pending_frames = 0
        if in_blood_state:
            dist_text, dist_color = "TIP IN BLOOD", (0, 0, 255)
            if tip_px is not None:
                cv2.circle(annotated, tip_px, 14, (0, 0, 255), 3)

        # ---------------- overlay ----------------
        now = time.perf_counter()
        dt, last_time = now - last_time, now
        if dt > 0:
            loop_fps = 1.0 / dt if loop_fps is None else SMOOTH * loop_fps + (1 - SMOOTH) / dt
        put(annotated, f"FPS: {loop_fps or 0:.1f}  |  Inference: {infer_ms:.0f} ms  |  ECM {args.topic}", (10, 34), (0, 255, 0))
        if dist_text:
            put(annotated, dist_text, (10, 72), dist_color, 0.95)
        put(annotated, "PERCEPTION ONLY - robot not controlled", (10, 108), (200, 200, 200), 0.6)
        if time.time() < saved_msg_until:
            put(annotated, "Image saved for training", (10, 140), (255, 0, 255), 0.7)
        if log:
            put(annotated, "REC", (WIDTH - 80, 34), (0, 0, 255), 0.8)
        if aruco_on:
            a_txt = (f"ArUco {len(aruco_ids)}: " + ",".join(map(str, aruco_ids))) if aruco_ids else \
                    ("ArUco: none" if aruco_dict else "ArUco: searching...")
            put(annotated, a_txt, (10, HEIGHT - 16), (0, 255, 0) if aruco_ids else (160, 160, 160), 0.7)

        if tip_px is not None:
            fovea_c = tip_px if fovea_c is None else (
                FOVEA_FOLLOW * tip_px[0] + (1 - FOVEA_FOLLOW) * fovea_c[0],
                FOVEA_FOLLOW * tip_px[1] + (1 - FOVEA_FOLLOW) * fovea_c[1])
        elif fovea_c is None:
            fovea_c = (WIDTH / 2, HEIGHT / 2)
        fx, fy, half = int(round(fovea_c[0])), int(round(fovea_c[1])), FOVEA // 2
        cv2.rectangle(annotated, (fx - half, fy - half), (fx + half, fy + half), (255, 0, 255), 1)

        cv2.imshow(WIN_MAIN, annotated)
        cv2.imshow(WIN_FOVEA, make_fovea_view(frame, class_masks, fovea_c, tip_px is not None))
        if video_writer and annotated.shape[:2] == (HEIGHT, WIDTH):
            video_writer.write(annotated)
            raw_writer.write(frame)

        frame_idx += 1
        elapsed_s = time.time() - t_start
        if log:
            log.writerow([f"{elapsed_s:.3f}", frame_idx, int(tip_mask is not None), int(blood_mask is not None),
                          tip_px[0] if tip_px else "", tip_px[1] if tip_px else "",
                          int(in_blood_state), int(raw_in),
                          f"{dist_px:.1f}" if dist_px is not None else "",
                          f"{dist_s:.1f}" if dist_s is not None else "", status, " ".join(map(str, aruco_ids))])
        if args.snapshots and elapsed_s - last_snap >= 1.0:
            last_snap = elapsed_s
            cv2.imwrite(os.path.join(args.snapshots, f"snap_{int(elapsed_s):04d}.jpg"), annotated)
        if args.seconds and elapsed_s >= args.seconds:
            break

        key = cv2.waitKey(1) & 0xFF
        if key in (ord("+"), ord("="), ord("-"), ord("_"), ord("0")):
            if key == ord("0"):
                win_scale = 1.0
            elif key in (ord("+"), ord("=")):
                win_scale = min(win_scale * SCALE_STEP, SCALE_MAX)
            else:
                win_scale = max(win_scale / SCALE_STEP, SCALE_MIN)
            cv2.resizeWindow(WIN_MAIN, int(WIDTH * win_scale), int(HEIGHT * win_scale))
        if key == ord("q"):
            break
        if key == ord("f"):
            os.makedirs(TRAIN_DIR, exist_ok=True)
            p = os.path.join(TRAIN_DIR, time.strftime("ecm_img_%Y%m%d_%H%M%S_") + f"{frame_idx:06d}.jpg")
            cv2.imwrite(p, frame)
            print("Saved for training:", p)
            saved_msg_until = time.time() + 1.5

except KeyboardInterrupt:
    pass
finally:
    run_end = time.time()
    cv2.destroyAllWindows()
    node.destroy_node()
    if rclpy.ok():
        rclpy.shutdown()
    if log_f:
        log_f.close()
        print("Log saved:", log_path)
    if video_writer:
        print("Converting videos, please wait...")
        finish_video(video_writer, video_path)
        finish_video(raw_writer, raw_path)
